<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Heavenly Home | Bible Quiz</title><style>
:root{font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#1c2935;background:#f5f7fa}*{box-sizing:border-box}body{margin:0}main{max-width:720px;margin:auto;padding:24px 16px 60px}header{text-align:center;padding:20px 0}h1{font-size:clamp(2rem,6vw,3rem);margin:.2em 0}p{line-height:1.5}.muted{color:#536579}.question{background:white;border:1px solid #dce3ea;border-radius:16px;padding:20px;margin:14px 0;box-shadow:0 2px 9px #1b35500a}.question h2{font-size:1.08rem;margin:0 0 15px}.choices{display:flex;gap:10px}.choices button, #reset{cursor:pointer;border:1px solid #8b9db0;background:white;border-radius:9px;padding:12px 20px;font-size:1rem;font-weight:650;min-width:100px}.choices button[aria-pressed=true]{background:#143e62;color:white;border-color:#143e62}.feedback{background:#edf3f8;border-radius:9px;padding:12px;margin-top:14px;line-height:1.5}.feedback[hidden]{display:none}.feedback strong{display:block;margin-bottom:3px}#reset{display:block;margin:24px auto}footer{text-align:center;color:#536579;font-size:.9rem}button:focus-visible{outline:3px solid #e7a83e;outline-offset:3px}</style></head><body><main><header><div class="muted">Star of Bethlehem Lutheran Church</div><h1>Heavenly Home</h1><p>How much do you know about heaven? Choose True or False to see what Scripture says.</p><p class="muted" id="progress" aria-live="polite">0 of 7 answered</p></header><section id="quiz"></section><button id="reset" type="button">Start over</button><footer>No sign-in. No submissions. Your answers stay on this device while this page is open.</footer></main><script>
const questions=[
['Everyone who dies goes to a better place.',false,'John 3:16–18 — Eternal life is received through faith in Christ, not simply through death.'],
['We will recognize people in heaven.',true,'Matthew 8:11 — Abraham, Isaac, and Jacob retain their identities. This supports recognition, though not every detail is revealed.'],
['Heaven will be boring because all we do is sing.',false,'Revelation 22:3–5 — God’s servants worship, serve, and reign with him.'],
['We will have physical bodies in eternity.',true,'Philippians 3:20–21 — Christ will transform our lowly bodies to be like his glorious body.'],
['The Bible promises that our pets will be in heaven.',false,'Isaiah 11:6–9 — Scripture uses animal imagery to describe peace, but does not promise the resurrection of individual pets.'],
['There will be no sadness, pain, or death in heaven.',true,'Revelation 21:4 — God promises the complete removal of these consequences of sin.'],
['We know exactly what the new heaven and new earth will look like.',false,'1 Corinthians 2:9 — God’s promises are certain, but many details remain unrevealed.']
];
const quiz=document.getElementById('quiz'), progress=document.getElementById('progress');let selected={};
function render(){quiz.replaceChildren();questions.forEach(([q,correct,explanation],i)=>{const article=document.createElement('article');article.className='question';const title=document.createElement('h2');title.textContent=`${i+1}. ${q}`;article.append(title);const choices=document.createElement('div');choices.className='choices';[true,false].forEach(v=>{const b=document.createElement('button');b.type='button';b.textContent=v?'True':'False';b.setAttribute('aria-pressed',String(selected[i]===v));b.onclick=()=>{selected[i]=v;render();};choices.append(b)});article.append(choices);const feedback=document.createElement('div');feedback.className='feedback';feedback.hidden=selected[i]===undefined;if(!feedback.hidden){const label=document.createElement('strong');label.textContent=`${selected[i]===correct?'Correct! ':'Not quite. '}The answer is ${correct?'True':'False'}.`;feedback.append(label,document.createTextNode(explanation))}article.append(feedback);quiz.append(article)});progress.textContent=`${Object.keys(selected).length} of ${questions.length} answered`}
document.getElementById('reset').onclick=()=>{selected={};render();scrollTo({top:0,behavior:'smooth'})};render();
</script></body></html>
